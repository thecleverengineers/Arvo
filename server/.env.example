NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/arvo_dev?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Set AUTH_MODE=fast2sms for real SMS delivery. The API key stays on the server.
AUTH_MODE=demo
DEMO_OTP=246810
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_OTP_EXPIRY_MINUTES=10
ADMIN_MOBILE=

# Optional email verification. Configure all SMTP fields to enable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Arvo <no-reply@example.com>
